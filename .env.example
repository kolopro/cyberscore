# CyberScore — environment configuration.
# Copy to ".env" and fill in. NEVER commit the real .env (it is gitignored).

# --- Reputation engines (optional; empty = heuristic fallback) ----------------
# URLhaus (abuse.ch) auth key — https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY=
# Google Safe Browsing API key — https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_KEY=
# VirusTotal API key (free tier ~500/day) — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# --- Encrypted off-site backup (used by scripts/backup.sh) --------------------
# age PUBLIC key (recipient). Generate a keypair on your OWN machine:
#   age-keygen -o age-key.txt        # keep age-key.txt PRIVATE and OFF the server
# then copy the "Public key: age1..." value here.
AGE_RECIPIENT=

# rclone remote + path for off-site upload. Configure with: rclone config
# Examples: b2:cyberscore-backups  |  r2:cyberscore-backups  |  gdrive:backups/cyberscore
RCLONE_REMOTE=

# Retention
BACKUP_KEEP_LOCAL=7            # keep N newest encrypted copies on the server
BACKUP_PRUNE_REMOTE_DAYS=30    # delete remote backups older than N days (0 = keep forever)
